# ==========================================================
# Marketing Business Analytics Tool — Backend Configuration
# Academic Year 2026–2027
# ==========================================================

# ---- Database ----
# Option 1: MySQL (recommended for production)
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=marketing_analytics

# Option 2: SQLite (auto-fallback when MySQL is not configured)
# DATABASE_URL=sqlite:///marketing_analytics.db

# ---- Flask Security ----
SECRET_KEY=marketing-analytics-secret-key-ay2026-2027-change-in-production

# ==========================================================
# OFFICIAL EXTERNAL API CREDENTIALS
# All external API communication and credentials are stored
# exclusively here on the backend. NEVER expose these in the
# React frontend. (Specification Rules 23-24, 28)
# ==========================================================

# ---- Google Analytics 4 (GA4 Data API) ----
# Required to enable live website metrics, sessions, realtime
# GA_PROPERTY_ID=123456789
# GA_ACCESS_TOKEN=ya29.your_oauth_access_token
# GA_CREDENTIALS_PATH=path/to/service-account.json

# ---- Google Ads API ----
# Required to enable live campaign performance data
# GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
# GOOGLE_ADS_CLIENT_ID=your_client_id
# GOOGLE_ADS_CLIENT_SECRET=your_client_secret
# GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
# GOOGLE_ADS_CUSTOMER_ID=xxx-xxx-xxxx

# ---- Shopify Admin REST API ----
# Required to enable live orders, products, customer data
# SHOPIFY_SHOP_URL=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_your_access_token

# ---- Synchronization ----
# Interval in minutes for scheduled background synchronization
SCHEDULED_SYNC_INTERVAL_MINUTES=60
